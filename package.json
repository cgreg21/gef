{
  "name": "gnome-extension-framework",
  "version": "0.1.0-alpha.2",
  "private": false,
  "description": "A TypeScript framework and native UI component library for GNOME Shell 51 and GTK4.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "gef": "node dist/cli/src/index.js",
    "package:example": "node scripts/package-extension.mjs",
    "package:appimage": "node scripts/package-appimage.mjs",
    "package:app": "node scripts/package-app.mjs",
    "styles": "node dist/cli/src/index.js styles packages/examples/hello-world/stylesheet.scss dist/styles.css",
    "dev:watch": "node scripts/dev-watch.mjs",
    "prepack": "npm run build",
    "test:gnome": "npm run build && npm run package:example && bash scripts/test-gnome-shell-51.sh",
    "test:gtk": "npm run build && npm run package:example && node dist/cli/src/index.js compile tests/gtk4/two-way.gtpl dist/two-way.js && GTK_A11Y=none xvfb-run -a gjs -m tests/gtk4/smoke.js",
    "prepublishOnly": "npm run check",
    "build:ui-showcase": "npm run build && node dist/cli/src/index.js compile packages/examples/ui-showcase/template.gtpl dist/examples/ui-showcase/template.js",
    "build:kitchen-sink": "npm run build && node dist/cli/src/index.js compile packages/examples/kitchen-sink/template.gtpl dist/examples/kitchen-sink/template.js",
    "kitchen-sink": "npm run build:kitchen-sink && node --import node-gtk/register packages/examples/kitchen-sink/kitchen-sink-node.mjs",
    "test:node-gtk:availability": "node --import node-gtk/register tests/node-gtk/availability.mjs",
    "lint": "eslint .",
    "test:kitchen-sink": "npm run build:kitchen-sink && node --import node-gtk/register tests/node-gtk/kitchen-sink-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.2.4",
    "sass": "^1.89.2",
    "node-gtk": "4.1.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.1"
  },
  "bin": {
    "gef": "dist/cli/src/index.js"
  },
  "main": "./dist/compiler/src/index.js",
  "types": "./dist/compiler/src/index.d.ts",
  "files": [
    "dist",
    "scripts/package-appimage.mjs",
    "scripts/package-app.mjs",
    "scripts/package-windows.mjs",
    "scripts/package-macos.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/compiler/src/index.d.ts",
      "import": "./dist/compiler/src/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/src/index.d.ts",
      "import": "./dist/compiler/src/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/src/index.d.ts",
      "import": "./dist/runtime/src/index.js"
    },
    "./ui": {
      "types": "./dist/ui/src/index.d.ts",
      "import": "./dist/ui/src/index.js"
    },
    "./scripts/package-app.mjs": "./scripts/package-app.mjs",
    "./scripts/package-appimage.mjs": "./scripts/package-appimage.mjs",
    "./scripts/package-windows.mjs": "./scripts/package-windows.mjs",
    "./scripts/package-macos.mjs": "./scripts/package-macos.mjs"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cgreg21/gef.git"
  },
  "homepage": "https://github.com/cgreg21/gef#readme",
  "bugs": {
    "url": "https://github.com/cgreg21/gef/issues"
  },
  "keywords": [
    "gnome",
    "gnome-shell",
    "gnome-shell-extension",
    "gjs",
    "gtk4",
    "libadwaita",
    "framework",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
