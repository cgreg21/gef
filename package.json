{
  "name": "gnome-extension-framework",
  "version": "0.1.0",
  "private": false,
  "description": "A TypeScript framework for GNOME Shell 51 extensions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "gef": "node dist/cli/src/index.js",
    "package:example": "node scripts/package-extension.mjs",
    "styles": "node dist/cli/src/index.js styles packages/examples/hello-world/stylesheet.scss dist/styles.css",
    "dev:watch": "node scripts/dev-watch.mjs",
    "prepack": "npm run build",
    "test:gnome": "npm run build && npm run package:example && bash scripts/test-gnome-shell-51.sh",
    "test:gtk": "npm run build && xvfb-run -a gjs -m tests/gtk4/smoke.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.2.4",
    "sass": "^1.89.2"
  },
  "bin": {
    "gef": "dist/cli/src/index.js"
  },
  "main": "./dist/compiler/src/index.js",
  "types": "./dist/compiler/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/compiler/src/index.d.ts",
      "import": "./dist/compiler/src/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/src/index.d.ts",
      "import": "./dist/compiler/src/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/src/index.d.ts",
      "import": "./dist/runtime/src/index.js"
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
